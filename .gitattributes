# Auto detect text files and perform LF normalization
* text=auto

# Files that run inside Linux containers or as POSIX shell scripts MUST stay LF —
# a CRLF checkout on Windows breaks shebangs (/bin/sh^M) and Dockerfile RUN lines.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
sshd_config text eol=lf
