# .env.example — copy to .env and fill in, then `docker compose up -d`.
# docker compose auto-loads .env from this directory. .env is gitignored;
# NEVER commit real tokens.

# Twingate GraphQL API key for the tenant in seed.yaml (twingate.network).
# Needs permission to manage Resources + Certificate Authorities.
TWINGATE_API_KEY=

# Bearer token for the gwops admin API (every route except /healthz).
# Generate a strong value, e.g.: openssl rand -hex 32
GWOPS_ADMIN_TOKEN=

# Only needed if you set recording.enabled: true in seed.yaml — bearer token the
# gwops spool presents to your recording receiver's /ingest endpoint. Also uncomment
# GWOPS_RECORDING_TOKEN in compose.yaml.
# GWOPS_RECORDING_TOKEN=

# Optional: limited-scope bearer token for unattended callers (webhooks) that manage
# upstreams through the admin API. Requires twingate.access_allowlist and
# twingate.address_allowlist in seed.yaml, and must differ from GWOPS_ADMIN_TOKEN.
# Also uncomment GWOPS_AUTOMATION_TOKEN in compose.yaml.
# GWOPS_AUTOMATION_TOKEN=
