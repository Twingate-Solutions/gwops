# Rig sshd: certificate-only login for the user it runs as (`gateway`).
Port 2222
HostKey /tmp/ssh_host_ed25519_key
PidFile /tmp/sshd.pid
TrustedUserCAKeys /tmp/ssh-ca.pub
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no
StrictModes no
LogLevel VERBOSE
